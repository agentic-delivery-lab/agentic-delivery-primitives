{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentic-delivery-lab/agentic-delivery-primitives/blob/main/evaluations/contracts/evaluation-semantic-grader.schema.json",
  "title": "Semantic evaluation rubric v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "version", "method", "automatedInvocationAllowed", "criteria"],
  "properties": {
    "$schema": { "const": "../contracts/evaluation-semantic-grader.schema.json" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "method": { "const": "manual-only" },
    "automatedInvocationAllowed": { "const": false },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "evidenceRequired"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "question": { "type": "string", "minLength": 1 },
          "evidenceRequired": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
